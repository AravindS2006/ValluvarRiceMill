---
import Layout from '../layouts/Layout.astro';
import Page from '../components/Page.astro';
import { pages, nav, routeFor, t, ui, type Locale, type PageKey } from '../data/site';
export function getStaticPaths() {
  return (['en', 'ta'] as Locale[]).flatMap(locale => pages.map(page => ({ params: { path: routeFor(page, locale).replace(/^\/|\/$/g, '') || undefined }, props: { locale, page } })));
}
interface Props { locale: Locale; page: PageKey }
const { locale, page } = Astro.props; const c = ui[locale];
const descriptions: Record<PageKey, string> = { home: c.heroBody, mill: c.millIntro, journey: c.journeyIntro, rice: c.riceIntro, gallery: c.galleryIntro, contact: c.contactIntro };
---
<Layout locale={locale} page={page} title={page === 'home' ? (locale === 'en' ? 'The journey of a grain' : 'ஒரு தானியத்தின் பயணம்') : t(nav[page], locale)} description={descriptions[page]}><Page locale={locale} page={page} /></Layout>
