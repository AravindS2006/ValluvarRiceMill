---
import { withBase as assetPath, assetSrcset } from '../lib/paths';
import { ui, type Locale } from '../data/site';
import { filmFor, type FilmName } from '../data/media';
interface Props { name: FilmName; locale: Locale; hero?: boolean; caption?: string }
const { name, locale, hero = false, caption } = Astro.props;
const copy = ui[locale];
const film = filmFor(name);
const portraitHero = hero && film.portraitPoster;
---
<div class:list={['video-shell', { 'hero-video': hero }]} data-video-shell data-film={name} style={`--video-position: ${film.position || '50% 50%'}`}>
  <picture>
    {portraitHero && <source media="(max-width: 650px)" srcset={assetPath(portraitHero)} width="720" height="960" />}
    <img class="video-poster" src={assetPath(`${film.base}.webp`)} srcset={assetSrcset(`${film.base}-640.webp 640w, ${film.base}-960.webp 960w, ${film.base}.webp 1600w`)} sizes={hero ? '100vw' : '(max-width: 650px) 100vw, 50vw'} alt="" width="1600" height="900" loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} />
  </picture>
  <video data-lazy-video data-src={assetPath(`${film.base}.mp4`)} data-mobile-src={assetPath(`${film.base}${portraitHero ? '-portrait' : '-mobile'}.mp4`)} autoplay muted loop playsinline preload="none" aria-label={caption || copy.watch}>
    <track kind="captions" src={assetPath(`/media/${locale}.vtt`)} srclang={locale} label={locale === 'ta' ? 'தமிழ்' : 'English'} />
  </video>
  <button class="video-toggle" type="button" data-video-toggle data-pause={copy.pause} data-play={copy.resume} aria-label={copy.resume} aria-pressed="false"><span data-video-icon aria-hidden="true">▶</span><span class="sr-only" data-video-label>{copy.resume}</span></button>
  <span class="video-failure" hidden>{copy.videoError}</span>
</div>
