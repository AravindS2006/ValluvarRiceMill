---
import { withBase as assetPath, assetSrcset } from '../lib/paths';
import { business, faqs, pathFor, stages, t, ui, type Locale, type PageKey } from '../data/site';
import Video from './Video.astro';
import Products from './Products.astro';
import CTA from './CTA.astro';
import Scene from './Scene.astro';
import Enquiry from './Enquiry.astro';
import Mark from './Mark.astro';
import LifecycleArt from './LifecycleArt.astro';
interface Props { locale: Locale; page: PageKey }
const { locale, page } = Astro.props; const c = ui[locale];
const homeStages = [0, 2, 4, 5, 7];
const gallery = [
  { image: 'planting', title: { en: 'The beginning of something good.', ta: 'நல்லதொரு தொடக்கம்.' }, label: { en: '01 / NURSERY & PLANTING', ta: '01 / நாற்றங்கால் மற்றும் நடவு' } },
  { image: 'paddy', title: { en: 'Between green and gold.', ta: 'பசுமைக்கும் பொன்மைக்கும் இடையில்.' }, label: { en: '02 / RIPENING PANICLES', ta: '02 / முதிரும் கதிர்கள்' } },
  { image: 'harvest', title: { en: 'The work of a season.', ta: 'ஒரு பருவத்தின் உழைப்பு.' }, label: { en: '03 / HARVEST TIME', ta: '03 / அறுவடை நேரம்' } },
  { image: 'grain', title: { en: 'A world within a grain.', ta: 'ஒரு தானியத்திற்குள் ஒரு உலகம்.' }, label: { en: '04 / WHITE RICE, UP CLOSE', ta: '04 / வெள்ளை அரிசி அருகில்' } },
];
---
{page === 'home' && <>
  <section class="hero">
    <Video name="paddy" locale={locale} hero />
    <div class="hero-shade"></div>
    <div class="hero-content"><p class="eyebrow"><span class="tiny-line"></span>{c.heroEyebrow}</p><h1>{c.heroTitle.map((line, i) => <span class:list={{ 'hero-italic': i === 2 }}>{line}</span>)}</h1><p class="hero-description">{c.heroBody}</p><div class="hero-buttons"><a class="button button-light" href={pathFor('journey', locale)}>{c.explore}<span aria-hidden="true">↗</span></a><a class="hero-secondary" href={pathFor('rice', locale)}>{c.allRice}<span aria-hidden="true">↗</span></a></div></div>
    <div class="hero-aside"><div class="earth-seal"><Mark /><span>FROM SEED<br />TO TABLE</span></div><p class="multiline">{c.heroSide}</p></div>
    <div class="hero-bottom"><span>{c.since}</span><a href="#story" aria-label={c.scroll}><span>{c.scroll}</span><span class="scroll-arrow" aria-hidden="true">↓</span></a></div>
  </section>
  <div class="seed-strip" aria-hidden="true"><span>{locale === 'ta' ? 'மண்' : 'THE EARTH'}</span><i></i><span>{locale === 'ta' ? 'பருவம்' : 'THE SEASON'}</span><i></i><span>{locale === 'ta' ? 'உழைப்பு' : 'THE CARE'}</span><i></i><span>{locale === 'ta' ? 'தானியம்' : 'THE GRAIN'}</span></div>
  <section class="story-grid section-pad" id="story">
    <div class="story-media"><img src={assetPath("/media/planting.webp")} srcset={assetSrcset("/media/planting-640.webp 640w, /media/planting-960.webp 960w, /media/planting.webp 1600w")} sizes="(max-width: 650px) 100vw, 45vw" alt={locale === 'ta' ? 'நீர்நிறைந்த வயலில் நாற்று நடும் விவசாயிகள் — விளக்கக் காட்சி' : 'Farmers planting in a flooded paddy — illustrative stock photograph'} loading="lazy" width="1600" height="900" /><div class="story-inset"><img src={assetPath("/media/grain-640.webp")} alt="" loading="lazy" width="640" height="427" /><span>{locale === 'ta' ? 'ஒவ்வொரு தானியத்திலும் அக்கறை' : 'A little grain. A lot of care.'}</span></div><span class="photo-index">01 / {locale === 'ta' ? 'வேர்கள்' : 'OUR ROOTS'}</span></div>
    <div class="story-copy"><p class="eyebrow">{c.storyTag}</p><h2 class="multiline">{c.storyTitle}</h2><p>{c.storyBody}</p><a class="text-link" href={pathFor('mill', locale)}>{c.storyLink}<span aria-hidden="true">↗</span></a><div class="story-coordinate"><span aria-hidden="true">⌖</span><span>DHARAPURAM, TAMIL NADU<br /><small>{locale === 'ta' ? 'எங்கள் கதையின் தொடக்கம்' : 'WHERE OUR STORY BEGINS'}</small></span></div></div>
  </section>
  <section class="journey-teaser section-pad"><div class="section-heading"><div><p class="eyebrow">{c.journeyTag}</p><h2>{c.journeyTitle}</h2></div><p>{c.journeyBody}</p></div><div class="grain-timeline">{homeStages.map((index, position) => <a href={`${pathFor('journey', locale)}#chapter-${index + 1}`} class="timeline-stage"><span class="timeline-number">0{position + 1}</span><div class={`stage-drawing drawing-${position}`} aria-hidden="true">{position === 0 ? <svg viewBox="0 0 100 100" fill="none"><path d="M50 75V40C50 22 66 14 75 20C75 39 60 44 50 40M50 57C30 59 23 44 25 35C41 33 48 42 50 57M40 81h20" stroke="currentColor" stroke-width="2"/><ellipse cx="50" cy="77" rx="9" ry="5" fill="currentColor"/></svg> : position < 3 ? <Mark large /> : position === 3 ? <svg viewBox="0 0 100 100" fill="none"><path d="M30 83L65 18M40 63L74 32M45 49L70 21M29 66L51 23M32 77L70 51" stroke="currentColor" stroke-width="2"/><path d="M27 79Q65 90 83 59" stroke="currentColor" stroke-width="5"/></svg> : <svg viewBox="0 0 100 100" fill="none"><ellipse cx="50" cy="50" rx="15" ry="34" transform="rotate(30 50 50)" stroke="currentColor" stroke-width="2"/><path d="M36 72L63 27" stroke="currentColor"/></svg>}</div><h3>{t(stages[index].label, locale)}</h3><span class="timeline-link" aria-hidden="true">↗</span></a>)}</div><a class="text-link" href={pathFor('journey', locale)}>{c.chapterLink}<span aria-hidden="true">↗</span></a></section>
  <section class="harvest-band"><Video name="harvest" locale={locale} /><div class="harvest-overlay"><p class="eyebrow">{locale === 'ta' ? 'இயற்கையின் தாளத்தில்' : 'IN RHYTHM WITH NATURE'}</p><h2>{locale === 'ta' ? 'நல்ல உணவின் தொடக்கம்,\nநல்ல மண்.' : 'Good food begins\nwith good earth.'}</h2><a class="round-play" href={`${pathFor('journey', locale)}#chapter-6`} aria-label={c.watch}>↗</a></div></section>
  <section class="collection section-pad"><div class="section-heading"><div><p class="eyebrow">{c.collectionTag}</p><h2>{c.collectionTitle}</h2></div><a class="text-link" href={pathFor('rice', locale)}>{c.collectionLink}<span aria-hidden="true">↗</span></a></div><Products locale={locale} /></section>
  <CTA locale={locale} />
</>}

{page === 'mill' && <>
  <section class="page-heading section-pad"><p class="eyebrow">{c.millTag}</p><div class="page-heading-row"><h1 class="multiline">{c.millTitle}</h1><p>{c.millIntro}</p></div></section>
  <section class="mill-panorama"><Video name="planting" locale={locale} /><span class="panorama-label">{c.stockNote}</span></section>
  <section class="editorial-grid section-pad"><div class="year-block"><span>{locale === 'ta' ? 'தொடங்கிய ஆண்டு' : 'OUR BEGINNING'}</span><strong>1992</strong><span>DHARAPURAM · TAMIL NADU</span></div><div><p class="eyebrow">{c.storyTag}</p><h2>{c.historyTitle}</h2><p>{c.historyBody}</p><a class="source-link" href="https://connect.acuite.in/fcompany-details/THIRUMURUGAN_AGRO_TECH_RICE_INDUSTRIES/4th_Nov_22" target="_blank" rel="noopener noreferrer">{c.source} ↗</a></div></section>
  <section class="company-profile section-pad"><div><p class="eyebrow">{c.profileTag}</p><h2>{c.profileTitle}</h2><p>{c.profileBody}</p><div class="company-sources"><a class="source-link" href="https://indiankanoon.org/doc/5937846/" target="_blank" rel="noopener noreferrer">{c.trademarkSource} ↗</a><a class="source-link" href="https://connect.acuite.in/fcompany-details/THIRUMURUGAN_AGRO_TECH_RICE_INDUSTRIES/25th_Apr_25" target="_blank" rel="noopener noreferrer">{c.companySource} ↗</a></div></div><dl><div><dt>{c.registeredBrand}</dt><dd>{locale === 'ta' ? 'வள்ளுவர் பிராண்ட் அரிசி' : 'Valluvar Brand Rice'}</dd></div><div><dt>{c.proprietor}</dt><dd>{locale === 'ta' ? 'ஆர். ஆர். சிதம்பரசாமி' : business.proprietor}</dd></div><div><dt>{c.registeredBusiness}</dt><dd>{business.legalName}</dd></div><div><dt>{c.manufacturing}</dt><dd>{locale === 'ta' ? 'தாராபுரம், தமிழ்நாடு' : 'Dharapuram, Tamil Nadu'}</dd></div></dl></section>
  <section class="process-section section-pad"><div><p class="eyebrow">{c.processTag}</p><h2>{c.processTitle}</h2><p>{c.processBody}</p><a class="text-link" href={`${pathFor('journey', locale)}#inside-grain`}>{c.millingTag}<span aria-hidden="true">↗</span></a></div><img src={assetPath("/media/grain.webp")} alt={locale === 'ta' ? 'வெள்ளை அரிசி மணிகளின் விளக்கப்படம்' : 'Illustrative close-up of white rice grains'} loading="lazy" width="1600" height="1067" /></section>
  <section class="place-section section-pad"><span class="place-emblem" aria-hidden="true"><Mark large /></span><div><p class="eyebrow">{c.placeTag}</p><h2 class="multiline">{c.placeTitle}</h2></div><p>{c.placeBody}</p></section><CTA locale={locale} />
</>}

{page === 'rice' && <>
  <section class="page-heading section-pad"><p class="eyebrow">{c.collectionTag}</p><div class="page-heading-row"><h1 class="multiline">{c.riceTitle}</h1><p>{c.riceIntro}</p></div></section>
  <section class="rice-collection section-pad"><h2 class="sr-only">{c.collectionTitle}</h2><Products locale={locale} /></section>
  <section class="rice-guide section-pad"><Mark large /><div><p class="eyebrow">{c.ctaTag}</p><h2 class="multiline">{c.riceGuideTitle}</h2><p>{c.riceGuideBody}</p><a class="text-link" href={pathFor('contact', locale)}>{c.enquiry}<span aria-hidden="true">↗</span></a></div></section><CTA locale={locale} />
</>}

{page === 'journey' && <>
  <section class="page-heading journey-heading section-pad"><p class="eyebrow">{c.journeyTag}</p><div class="page-heading-row"><h1 class="multiline">{c.journeyPageTitle}</h1><p>{c.journeyIntro}</p></div><a href="#chapters" class="text-link">{c.viewJourney}<span aria-hidden="true">↓</span></a></section>
  <section class="growth-section section-pad"><div><p class="eyebrow">{c.cultivation}</p><h2 class="multiline">{c.cultivationTitle}</h2><p>{c.cultivationBody}</p><span class="mini-label">01 — 03 / ORYZA SATIVA</span></div><Scene locale={locale} mode="growth" /></section>
  <section class="journey-chapters section-pad" id="chapters">
    <aside class="chapter-sidebar"><p class="eyebrow">{c.chapters}</p><div class="sticky-chapter-media">{stages.map((stage,i)=><div class="journey-panel" data-journey-panel={i+1} hidden={i!==0}>{[0,3,6,7,8].includes(i)?<LifecycleArt stage={i} locale={locale}/>:<Video name={i===2?'planting':stage.media as 'planting'|'paddy'|'harvest'} locale={locale} caption={t(stage.label,locale)}/>}</div>)}</div><nav aria-label={c.chapters}>{stages.map((stage, i) => <a href={`#chapter-${i + 1}`} data-chapter-link={i + 1}><span>{String(i + 1).padStart(2, '0')}</span>{t(stage.label, locale)}</a>)}</nav><p class="caption">{c.journeyEvidence}</p></aside>
    <div class="chapter-list">{stages.map((stage, i) => <article class="chapter" id={`chapter-${i + 1}`} data-chapter={i + 1}><div class="chapter-heading"><span class="chapter-number">{String(i + 1).padStart(2, '0')}</span><div><p class="eyebrow">{t(stage.label, locale)}</p><h2>{t(stage.title, locale)}</h2></div></div><div class="chapter-media">{[0,3,6,7,8].includes(i) ? <LifecycleArt stage={i} locale={locale}/> : <Video name={i===2?'planting':stage.media as 'planting'|'paddy'|'harvest'} locale={locale} caption={t(stage.label, locale)} />}</div><p>{t(stage.body, locale)}</p></article>)}</div>
  </section>
  <section class="milling-section section-pad" id="inside-grain"><div><p class="eyebrow">{c.millingTag}</p><h2 class="multiline">{c.millingTitle}</h2><p>{c.millingIntro}</p><a class="source-link" href="https://www.knowledgebank.irri.org/ericeproduction/PDF_%26_Docs/Teaching_Manual_Rice_Milling.pdf" target="_blank" rel="noopener noreferrer">{locale === 'ta' ? 'ஆதாரம்: IRRI அரிசி அரைத்தல் கையேடு' : 'Explore the science · IRRI milling manual'} ↗</a></div><Scene locale={locale} mode="grain" /></section><CTA locale={locale} />
</>}

{page === 'gallery' && <>
  <section class="page-heading section-pad"><p class="eyebrow">{c.galleryLabel}</p><div class="page-heading-row"><h1 class="multiline">{c.galleryTitle}</h1><p>{c.galleryIntro}</p></div></section>
  <section class="gallery-grid section-pad">{gallery.map((item, i) => <figure class={`gallery-item gallery-item-${i}`}><button type="button" data-open-dialog={`image-${item.image}`} aria-label={`${c.openImage}: ${t(item.title, locale)}`}><img src={assetPath(`/media/${item.image}.webp`)} alt={t(item.title, locale)} width="1600" height={item.image === 'grain' ? '1067' : '900'} loading={i === 0 ? 'eager' : 'lazy'} /><span class="gallery-expand" aria-hidden="true">↗</span></button><figcaption><p class="eyebrow">{t(item.label, locale)}</p><h2>{t(item.title, locale)}</h2></figcaption><dialog class="image-dialog" id={`image-${item.image}`}><button class="dialog-close" type="button" data-close-dialog aria-label={c.close}>×</button><img src={assetPath(`/media/${item.image}.webp`)} alt={t(item.title, locale)} width="1600" height={item.image === 'grain' ? '1067' : '900'} /><p>{t(item.title, locale)}</p><p class="caption">{c.stockNote}</p></dialog></figure>)}</section>
  <section class="gallery-films section-pad"><div class="section-heading"><div><p class="eyebrow">{c.journeyTag}</p><h2>{c.watch}</h2></div><p>{c.stockNote}</p></div><div class="film-grid"><Video name="planting" locale={locale} /><Video name="harvest" locale={locale} /></div></section><CTA locale={locale} />
</>}

{page === 'contact' && <>
  <section class="page-heading section-pad"><p class="eyebrow">{c.ctaTag}</p><div class="page-heading-row"><h1 class="multiline">{c.contactTitle}</h1><p>{c.contactIntro}</p></div></section>
  <section class="contact-layout section-pad"><Enquiry locale={locale} /><aside class="contact-aside"><div class="contact-location"><Mark /><p class="eyebrow">{c.findUs}</p><h2>{locale === 'ta' ? 'தாராபுரம்,\nதமிழ்நாடு.' : 'Dharapuram,\nTamil Nadu.'}</h2><p>{locale === 'ta' ? 'ஆர். ஆர். சித்தம்பரசாமி,\nதிருமுருகன் மாடர்ன் ரைஸ் மில்\nபழனி சாலை, ஆச்சியூர் அஞ்சல், தாராபுரம்\nதமிழ்நாடு, இந்தியா' : `${business.legalName}\nPalani Road, Achiyur Post, Dharapuram\nTamil Nadu, India`}</p></div><div class="contact-image"><img src={assetPath("/media/paddy.webp")} alt="" loading="lazy" width="1600" height="900" /></div><p class="caption">{c.previewNote}</p></aside></section>
  <section class="faq-section section-pad"><div><p class="eyebrow">{locale === 'ta' ? 'பொதுவான கேள்விகள்' : 'A LITTLE MORE CLARITY'}</p><h2 class="multiline">{c.faqTitle}</h2></div><div class="faq-list">{faqs.map(faq => <details><summary>{t(faq.q, locale)}<span aria-hidden="true">+</span></summary><p>{t(faq.a, locale)}</p></details>)}</div></section>
</>}
