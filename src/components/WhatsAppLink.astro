---
import { business, ui, type Locale } from '../data/site';
import { salesWhatsapp } from '../lib/contact';
interface Props { locale: Locale; floating?: boolean }
const { locale, floating = false } = Astro.props;
const c = ui[locale];
const link = salesWhatsapp(locale);
---
{link && <a class:list={['whatsapp-link', { 'whatsapp-floating': floating }]} href={link} target="_blank" rel="noopener noreferrer" aria-label={`${c.chatWithUs} · ${business.phoneDisplay}`}>
  <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M26 15.5A10.5 10.5 0 0 1 10.7 25L5 27l1.8-5.9A10.5 10.5 0 1 1 26 15.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="m12 10-1.5 1.5c-.8 2.4 4.8 8 7.5 7.7l1.8-1.7-3-1.8-1.3 1c-1.2-.5-2.2-1.5-2.8-2.8l1-1.2L12 10Z" fill="currentColor"/></svg>
  <span>{c.chatWithUs}</span>
</a>}
